# FACEATTEND — environment template (copy to .env; NEVER commit .env)
# See audit-output/PHASE_1A_SECURITY_REPORT.md for the bootstrap policy.
#
# ENVIRONMENT contract (enforced at import; no silent fallback):
# - development: explicit local development only (LOCAL-ONLY defaults below).
# - test: controlled test runs only.
# - production: strong, explicitly configured secrets (see docker-compose.prod.yml).
# Missing, blank, or unsupported values refuse to start the application.
ENVIRONMENT=development

# PostgreSQL (docker compose service "db"). LOCAL-ONLY defaults.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=analytics
DATABASE_URL=postgresql://analytics:change_me_in_env@db:5432/analytics

# Auth — REQUIRED in production (>= 32 chars, not a documented default).
# Production uses docker-compose.prod.yml, which REQUIRES these values via
# environment interpolation and ignores the placeholders below.
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_TTL_S=86400

# Initial operator account (users table, role=admin).
# - Development: seeded automatically on first login when the table is empty
#   (warning logged to stderr). Explicitly set ADMIN_PASSWORD to choose it.
# - Production: users table is NOT auto-seeded with defaults. Set a strong
#   ADMIN_PASSWORD (>= 12 chars, not admin123) before first boot; startup
#   validation fails fast otherwise.
ADMIN_USER=admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change_me_min_12_chars

# Face pipeline. MODEL_LOAD_SECONDS is the per-attempt load TIMEOUT bound
# (plus intentional chaos delays) — not a mandatory wait. Fast loads go
# READY immediately; overruns end in an explicit FAILED_TIMEOUT (recoverable).
MODEL_LOAD_SECONDS=15
YOLO_WEIGHTS=yolov8n-face.pt
FACE_BACKEND_ORDER=yolo,mediapipe,haar
REID_THRESHOLD=0.85

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend build-time configuration (requires `docker compose build` after
# changing; CRA embeds these values into the static bundle at build time).
# - VITE_API_URL / REACT_APP_API_URL: backend base URL baked into the bundle.
#   Defaults point at a local backend; override for staging deployments.
# - REACT_APP_ORG_NAME: white-label branding shown on the login screen.
#   Leave commented out (or empty) to keep the built-in default. Example:
#   REACT_APP_ORG_NAME=Your Institution
#   (Uncomment, then rebuild: docker compose build frontend)
